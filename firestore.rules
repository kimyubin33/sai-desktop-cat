rules_version = '2';

// 사이 — 팀 연결용 Firestore 보안 규칙
// 원칙
//  - 대화 원문·문안은 서버에 올라오지 않는다. 주제 id, 받는 사람, 주(週), 보류 여부만 오간다.
//  - 조언 신호(signals)에는 보낸 사람 정보가 없다. 받는 사람만 목록으로 볼 수 있고,
//    보낸 사람은 자기가 받은 문서 id 로만 상태(보류 여부)를 확인할 수 있다.
//  - 팀원만 팀 데이터에 접근한다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(teamId) {
      return signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    // 팀 관리자: 관리자 아이디·비밀번호로 로그인한 기기 (admins/<uid> 문서가 있다)
    function isAdmin(teamId) {
      return signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/admins/$(request.auth.uid));
    }

    function validTopic(t) {
      return t is string && t.size() > 0 && t.size() <= 40 && t.matches('^[a-z_]+$');
    }

    function validWeek(w) {
      return w is string && w.matches('^[0-9]{4}-W[0-9]{2}$');
    }

    // 참여 코드 → 팀. 코드를 아는 사람만 하나씩 조회할 수 있다 (목록 조회 불가).
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['teamId', 'teamName'])
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.joinCode == code;
      allow update, delete: if false;
    }

    match /teams/{teamId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'joinCode', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow get: if isMember(teamId) || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow list, update, delete: if false;

      match /members/{memberId} {
        allow get: if (signedIn() && request.auth.uid == memberId) || isMember(teamId);
        allow list: if isMember(teamId);
        // 참여 코드를 알아야 들어올 수 있고, 같은 이름의 팀원이 없어야 한다 (names/<이름> 을 내가 잡고 있어야 함)
        allow create: if signedIn() && request.auth.uid == memberId
          && request.resource.data.keys().hasOnly(['displayName', 'joinCode', 'nameKey'])
          && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 30
          && request.resource.data.joinCode == get(/databases/$(database)/documents/teams/$(teamId)).data.joinCode
          && request.resource.data.nameKey is string
          && getAfter(/databases/$(database)/documents/teams/$(teamId)/names/$(request.resource.data.nameKey)).data.uid == request.auth.uid;
        allow update: if signedIn() && request.auth.uid == memberId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'nameKey'])
          && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 30
          && request.resource.data.nameKey is string
          && getAfter(/databases/$(database)/documents/teams/$(teamId)/names/$(request.resource.data.nameKey)).data.uid == request.auth.uid;
        // 나가기는 본인, 내보내기는 관리자만
        allow delete: if signedIn() && (request.auth.uid == memberId || isAdmin(teamId));
      }

      // 이름 잡아 두기: 한 팀에 같은 이름은 한 명만. 문서 id 가 이름이고, 먼저 잡은 사람의 것이다
      match /names/{nameKey} {
        // 들어오기 전에 이름이 비었는지 확인할 수 있어야 한다
        allow get: if signedIn();
        allow list: if isMember(teamId);
        // 팀원(또는 지금 함께 팀원이 되는 사람)만 자기 이름으로 잡는다
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid
          && existsAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
        allow update: if false;
        // 본인, 관리자, 또는 잡아 둔 사람이 이미 팀을 나갔을 때 팀원 누구나
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin(teamId)
          || (isMember(teamId) && !exists(/databases/$(database)/documents/teams/$(teamId)/members/$(resource.data.uid))));
      }

      // ---------- 관리자 ----------
      // 관리자 아이디와, 비밀번호 확인에 쓰는 소금값. 비밀번호 자체는 어디에도 없다.
      // 처음 한 번만 만들 수 있다 (만든 사람이 관리자가 된다)
      match /admin/config {
        allow get: if isMember(teamId);
        allow create: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['adminId', 'salt', 'by'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.adminId is string && request.resource.data.adminId.size() <= 30;
        allow update, delete: if false;
      }
      // 아이디·비밀번호로 계산한 값이 문서 id. 값을 정확히 아는 사람만 하나씩 조회할 수 있다 (목록 조회 불가)
      match /adminKeys/{key} {
        allow get: if isMember(teamId);
        allow list: if false;
        // 관리자를 처음 정하는 바로 그 요청에서만 만들 수 있다
        allow create: if isMember(teamId)
          && !exists(/databases/$(database)/documents/teams/$(teamId)/admin/config)
          && getAfter(/databases/$(database)/documents/teams/$(teamId)/admin/config).data.by == request.auth.uid;
        allow update, delete: if false;
      }
      // 관리자로 로그인한 기기. 맞는 값을 내야만 만들 수 있다
      match /admins/{memberId} {
        allow get: if signedIn() && request.auth.uid == memberId;
        allow list: if false;
        allow create: if isMember(teamId) && request.auth.uid == memberId
          && request.resource.data.keys().hasOnly(['key'])
          && existsAfter(/databases/$(database)/documents/teams/$(teamId)/adminKeys/$(request.resource.data.key));
        allow update: if false;
        allow delete: if signedIn() && (request.auth.uid == memberId || isAdmin(teamId));
      }

      match /signals/{signalId} {
        allow create: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['topic', 'toMember', 'week', 'held'])
          && validTopic(request.resource.data.topic)
          && validWeek(request.resource.data.week)
          && request.resource.data.held == false
          && request.resource.data.toMember != request.auth.uid
          && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.resource.data.toMember));
        // 보낸 사람은 문서 id 를 알고 있으므로 get 으로 상태만 확인할 수 있다
        allow get: if isMember(teamId);
        // 목록은 받는 사람 자신의 것만
        allow list: if isMember(teamId) && resource.data.toMember == request.auth.uid;
        // 받는 사람이 "내 사정도 있어요"로 보류만 할 수 있다
        allow update: if isMember(teamId) && resource.data.toMember == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['held'])
          && request.resource.data.held == true;
        allow delete: if false;
      }

      // ---------- 협업 (4단계) ----------
      // 자기소개·역량·가능 시간: 팀원 모두 볼 수 있고, 본인만 고친다
      match /profiles/{memberId} {
        allow read: if isMember(teamId);
        allow create, update: if isMember(teamId) && request.auth.uid == memberId
          && request.resource.data.keys().hasOnly(['pr', 'skills', 'learn', 'weeklyHours', 'days'])
          && (!('pr' in request.resource.data) || request.resource.data.pr.size() <= 500)
          && (!('weeklyHours' in request.resource.data) || (request.resource.data.weeklyHours is number
              && request.resource.data.weeklyHours >= 0 && request.resource.data.weeklyHours <= 80));
        allow delete: if signedIn() && (request.auth.uid == memberId || isAdmin(teamId));
      }

      match /projects/{projectId} {
        allow read: if isMember(teamId);
        allow create, update: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['title', 'goal', 'deliverable', 'deadline'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 80;
        allow delete: if false;

        match /tasks/{taskId} {
          allow read: if isMember(teamId);
          allow create, update: if isMember(teamId)
            && request.resource.data.keys().hasOnly(['title', 'estimateHours', 'difficulty', 'skills', 'dependsOn',
                 'doneCriteria', 'prep', 'reviewer', 'assignee', 'accepted', 'status', 'startedAt', 'doneAt', 'objections'])
            && request.resource.data.title is string && request.resource.data.title.size() <= 80
            && request.resource.data.status in ['todo', 'doing', 'blocked', 'done']
            // 배정 수락은 맡은 사람 본인만
            && (!('accepted' in request.resource.data) || request.resource.data.accepted == false
                || request.resource.data.assignee == request.auth.uid
                || (resource != null && resource.data.get('accepted', false) == true
                    && resource.data.assignee == request.resource.data.assignee));
          allow delete: if isMember(teamId);
        }

        // 팀 자료: Google Drive 링크. 올린 사람 본인으로만 만들고, 지우기도 올린 사람만
        match /files/{fileId} {
          allow read: if isMember(teamId);
          allow create: if isMember(teamId)
            && request.resource.data.keys().hasOnly(['name', 'url', 'driveId', 'mimeType', 'size', 'taskId', 'access', 'kind', 'by', 'at'])
            && request.resource.data.by == request.auth.uid
            && request.resource.data.name is string && request.resource.data.name.size() <= 200
            && request.resource.data.url is string && request.resource.data.url.size() <= 500
            && request.resource.data.url.matches('https://.*');
          // 올린 사람만 팀원 편집 허용을 켜고 끈다
          allow update: if isMember(teamId) && resource.data.by == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['access'])
            && request.resource.data.access in ['edit', 'view'];
          allow delete: if isMember(teamId) && resource.data.by == request.auth.uid;
        }
      }

      // ---------- 팀 Drive 함: 파일 링크·메시지 주고받기 ----------
      match /shares/{shareId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['text', 'name', 'url', 'driveId', 'mimeType', 'size', 'access', 'by', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000
          && (!('url' in request.resource.data)
              || (request.resource.data.url is string && request.resource.data.url.size() <= 500
                  && request.resource.data.url.matches('https://.*')));
        allow delete: if isMember(teamId) && resource.data.by == request.auth.uid;
      }

      // ---------- 외부 연결 (5단계) ----------
      // 팀 공용 연결 정보 (Telegram 봇 토큰 등): 팀원만 읽고 쓴다
      match /integrations/{name} {
        allow read: if isMember(teamId);
        // Telegram 봇: 팀원 누구나 등록·변경
        allow create, update: if isMember(teamId) && name == 'telegram'
          && request.resource.data.keys().hasOnly(['botToken', 'botUsername'])
          && request.resource.data.botToken is string && request.resource.data.botToken.size() <= 100;
        // 팀에 공유한 Claude API 키: 공유한 사람만 바꾸고 끌 수 있다
        allow create: if isMember(teamId) && name == 'claude'
          && request.resource.data.keys().hasOnly(['apiKey', 'sharedBy'])
          && request.resource.data.apiKey is string && request.resource.data.apiKey.size() <= 300
          && request.resource.data.sharedBy == request.auth.uid;
        allow update: if isMember(teamId) && name == 'claude'
          && resource.data.sharedBy == request.auth.uid
          && request.resource.data.keys().hasOnly(['apiKey', 'sharedBy'])
          && request.resource.data.apiKey is string && request.resource.data.apiKey.size() <= 300
          && request.resource.data.sharedBy == request.auth.uid;
        allow delete: if isMember(teamId) && (name != 'claude' || resource.data.sharedBy == request.auth.uid);
      }

      // 내 Telegram 채팅 연결: 본인만 쓰고, 팀원은 업무 알림을 보내기 위해 읽는다
      match /telegram/{memberId} {
        allow read: if isMember(teamId);
        allow create, update: if isMember(teamId) && request.auth.uid == memberId
          && request.resource.data.keys().hasOnly(['chatId', 'teamAlerts'])
          && request.resource.data.chatId is int
          && request.resource.data.teamAlerts is bool;
        allow delete: if signedIn() && request.auth.uid == memberId;
      }

      match /proposals/{proposalId} {
        allow create: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['topic', 'week', 'responses'])
          && validTopic(request.resource.data.topic)
          && validWeek(request.resource.data.week)
          && request.resource.data.responses.size() == 0;
        allow read: if isMember(teamId);
        // 각자 자기 응답만 바꿀 수 있다
        allow update: if isMember(teamId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responses'])
          && request.resource.data.responses.diff(resource.data.responses).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.responses[request.auth.uid] in ['agree', 'later'];
        allow delete: if false;
      }
    }
  }
}
